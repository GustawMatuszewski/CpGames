<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/UI/Settings/Universal.uss?fileID=7433441132597879392&amp;guid=61163bb83260125189a86ec6c7ca18b4&amp;type=3#Universal"/>
    <Style src="project://database/Assets/UI/Settings/Audio/Audio.uss?fileID=7433441132597879392&amp;guid=8b82444544f7d656a86de9e72686b313&amp;type=3#Audio"/>
    <ui:VisualElement name="AudioSettings" style="flex-grow: 1; align-content: flex-start; justify-content: center; flex-direction: row; align-self: auto; align-items: flex-end;">
        <ui:VisualElement name="settingsRootDiv" style="flex-grow: 1; height: 100%;">
            <ui:VisualElement name="settingTitle">
                <ui:Label text="Sound Settings" name="settingsTitleLabel"/>
            </ui:VisualElement>
            <ui:VisualElement name="settingsDiv" class="settingsDiv" style="align-self: flex-end;">
                <ui:VisualElement name="MainSoundControl">
                    <ui:Slider label="Main Volume" value="42" high-value="100" fill="true" name="MasterVolume"/>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="settingDesc" class="settingDesc"/>
    </ui:VisualElement>
</ui:UXML>
