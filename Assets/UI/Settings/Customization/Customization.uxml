<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/UI/Settings/Universal.uss?fileID=7433441132597879392&amp;guid=61163bb83260125189a86ec6c7ca18b4&amp;type=3#Universal"/>
    <Style src="project://database/Assets/UI/Settings/Customization/Customization.uss?fileID=7433441132597879392&amp;guid=10e3a2e696a2096858c8babb86796e63&amp;type=3#Customization"/>
    <ui:VisualElement name="CustomizationSettings" style="flex-grow: 1; align-content: flex-start; justify-content: center; flex-direction: row; align-self: auto; align-items: flex-end;">
        <ui:VisualElement name="settingsRootDiv" style="flex-grow: 1; height: 100%;">
            <ui:VisualElement name="settingTitle" style="flex-grow: 1;">
                <ui:Label text="Customization Settings" name="settingsTitleLabel"/>
            </ui:VisualElement>
            <ui:VisualElement name="settingsDiv" class="settingsDiv" style="align-self: flex-end;">
                <ui:VisualElement name="BuildingGhostColor">
                    <ui:Label text="Ghost Building Color" data-source-type="UnityEngine.UIElements.AdvanceTextGeneratorDecoratorAttribute, UnityEngine.UIElementsModule"/>
                    <ui:VisualElement name="Color" style="flex-grow: 0; flex-direction: row; flex-wrap: nowrap; justify-content: flex-end;">
                        <ui:VisualElement name="ColorPrev" style="border-left-color: rgb(0, 0, 0); border-right-color: rgb(0, 0, 0); border-top-color: rgb(0, 0, 0); border-bottom-color: rgb(0, 0, 0); border-top-width: 2px; border-right-width: 2px; border-bottom-width: 2px; border-left-width: 2px;"/>
                        <ui:TextField label="Text Field" placeholder-text="filler text" name="ColorInput"/>
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="settingDesc" class="settingDesc"/>
    </ui:VisualElement>
</ui:UXML>
