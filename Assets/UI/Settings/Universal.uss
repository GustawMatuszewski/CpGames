.settingsDiv {
    align-self: center;
    width: 100%;
    height: 90%;
    align-content: auto;
    padding-top: 20px;
    padding-right: 20px;
    padding-bottom: 20px;
    padding-left: 20px;
    background-color: rgba(64, 64, 64, 0.78);
}

.settingDesc {
    flex-grow: 1;
    height: 100%;
    background-color: rgba(40, 40, 40, 0.59);
    width: 35%;
}

#settingTitle {
    background-color: rgb(255, 255, 255);
    padding-left: 20px;
    height: 10%;
}

#settingsTitleLabel {
    flex-grow: 1;
    font-size: 40px;
    -unity-font-definition: url("project://database/Assets/UI/fonts/Geist_Mono/static/GeistMono-ExtraBold.ttf?fileID=12800000&guid=30e1adb8f2439b54bb0d02f1469e2c39&type=3#GeistMono-ExtraBold");
    -unity-text-align: middle-left;
    height: auto;
    -unity-font-style: normal;
}

#settingsRootDiv {
    width: 65%;
}







.unity-base-dropdown__container-outer {
    background-color: rgb(255, 0, 0);
}
