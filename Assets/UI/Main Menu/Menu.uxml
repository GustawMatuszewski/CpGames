<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <ui:Template name="Audio" src="project://database/Assets/UI/Settings/Audio/Audio.uxml?fileID=9197481963319205126&amp;guid=b37ab664b64fd35ea81ca9bb17339351&amp;type=3#Audio"/>
    <ui:Template name="Customization" src="project://database/Assets/UI/Settings/Customization/Customization.uxml?fileID=9197481963319205126&amp;guid=8e9652bc6eb7d838e80c00b341c60ae8&amp;type=3#Customization"/>
    <ui:Template name="General" src="project://database/Assets/UI/Settings/General/General.uxml?fileID=9197481963319205126&amp;guid=368de15167aa69a5bb0e7c86a1c14d09&amp;type=3#General"/>
    <ui:Template name="KeyBinds" src="project://database/Assets/UI/Settings/KeyBinds/KeyBinds.uxml?fileID=9197481963319205126&amp;guid=4af1acfb7e1d41ab19a735bb41a05b95&amp;type=3#KeyBinds"/>
    <ui:Template name="Video" src="project://database/Assets/UI/Settings/Video/Video.uxml?fileID=9197481963319205126&amp;guid=e6ec10dc344bb1620836dbf6703c15e9&amp;type=3#Video"/>
    <Style src="project://database/Assets/UI/Main%20Menu/Menu%20Styles.uss?fileID=7433441132597879392&amp;guid=076dfdd9946cb62469c6a751007fcfa8&amp;type=3#Menu Styles"/>
    <ui:VisualElement name="root" style="flex-grow: 1; background-color: rgb(108, 102, 102); align-items: center; justify-content: flex-start;">
        <ui:VisualElement name="Logo" style="width: 100%; height: 300px;">
            <ui:Label text="Echoes of Pohnpei" style="flex-grow: 1; font-size: 100px; -unity-font-definition: url(&quot;project://database/Assets/UI/fonts/Geist_Mono/static/GeistMono-SemiBold.ttf?fileID=12800000&amp;guid=ae4391db741d57045bc53352d5289259&amp;type=3#GeistMono-SemiBold&quot;); -unity-font-style: bold; text-shadow: 5px 5px 10px rgb(168, 80, 80); letter-spacing: 10px; word-spacing: 20px; -unity-text-align: middle-center;"/>
        </ui:VisualElement>
        <ui:VisualElement name="MainMenu" style="margin-left: 0;">
            <ui:Button text="Play" name="PlayButton" class="AButton"/>
            <ui:Button text="Options" name="OptionsMenu" class="AButton"/>
            <ui:Button text="Quit&#10;" name="Quit" class="AButton"/>
        </ui:VisualElement>
    </ui:VisualElement>
    <ui:VisualElement name="Settings" style="flex-grow: 1; align-items: center; display: none; justify-content: center;">
        <ui:TabView name="SettingsTabs">
            <ui:Tab label="GENERAL" name="General" enabled="true" class="settingsTab">
                <ui:VisualElement name="TabRoot" class="SettingWindow" style="flex-grow: 1;">
                    <ui:Instance template="General" style="flex-grow: 1;"/>
                </ui:VisualElement>
                <ui:Button text="" name="closeSettings" class="closeSettings" style="background-image: url(&quot;project://database/Assets/UI/IMG/ICONS/X.png?fileID=2800000&amp;guid=7f9bbdbe50a3cc3e986f40a078b73636&amp;type=3#X&quot;); position: absolute;"/>
            </ui:Tab>
            <ui:Tab label="GRAPHIC" name="Video" class="settingsTab">
                <ui:VisualElement name="TabRoot" class="SettingWindow" style="flex-grow: 1;">
                    <ui:Instance template="Video" style="flex-grow: 1;"/>
                </ui:VisualElement>
                <ui:Button text="" name="closeSettings" class="closeSettings" style="background-image: url(&quot;project://database/Assets/UI/IMG/ICONS/X.png?fileID=2800000&amp;guid=7f9bbdbe50a3cc3e986f40a078b73636&amp;type=3#X&quot;); position: absolute;"/>
            </ui:Tab>
            <ui:Tab label="AUDIO" name="Audio" class="settingsTab">
                <ui:VisualElement name="TabRoot" class="SettingWindow" style="flex-grow: 1;">
                    <ui:Instance template="Audio" style="flex-grow: 1;"/>
                </ui:VisualElement>
                <ui:Button text="" name="closeSettings" class="closeSettings" style="background-image: url(&quot;project://database/Assets/UI/IMG/ICONS/X.png?fileID=2800000&amp;guid=7f9bbdbe50a3cc3e986f40a078b73636&amp;type=3#X&quot;); position: absolute;"/>
            </ui:Tab>
            <ui:Tab label="CUSTOMIZATION" name="Customization" closeable="false" class="settingsTab">
                <ui:VisualElement name="TabRoot" class="SettingWindow" style="flex-grow: 1;">
                    <ui:Instance template="Customization" style="flex-grow: 1;"/>
                </ui:VisualElement>
                <ui:Button text="" name="closeSettings" class="closeSettings" style="background-image: url(&quot;project://database/Assets/UI/IMG/ICONS/X.png?fileID=2800000&amp;guid=7f9bbdbe50a3cc3e986f40a078b73636&amp;type=3#X&quot;); position: absolute;"/>
            </ui:Tab>
            <ui:Tab label="KEY BINDINGS" name="KeyBinds" closeable="false" class="settingsTab">
                <ui:VisualElement name="TabRoot" class="SettingWindow" style="flex-grow: 1;">
                    <ui:Instance template="KeyBinds" style="flex-grow: 1;"/>
                </ui:VisualElement>
                <ui:Button text="" name="closeSettings" class="closeSettings" style="background-image: url(&quot;project://database/Assets/UI/IMG/ICONS/X.png?fileID=2800000&amp;guid=7f9bbdbe50a3cc3e986f40a078b73636&amp;type=3#X&quot;); position: absolute;"/>
            </ui:Tab>
        </ui:TabView>
    </ui:VisualElement>
</ui:UXML>
