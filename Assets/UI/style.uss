:root {
    --crafting-border-color: rgb(40, 40, 40);
    -unity-font-definition: url("project://database/Assets/UI/fonts/Geist_Mono/GeistMono-VariableFont_wght.ttf?fileID=12800000&guid=1c57bef169a781841b9158d64fafc3b6&type=3#GeistMono-VariableFont_wght");
    -unity-font-style: normal;
}

#Inventory {
    right: 0;
    position: absolute;
    overflow: visible;
    width: 55%;
    height: 100%;
}

#QSlots {
    background-color: rgba(255, 123, 0, 0.51);
    left: 0;
    right: auto;
    flex-shrink: 0;
    flex-wrap: nowrap;
    width: 10%;
    position: relative;
    border-right-width: 3px;
    border-left-width: 3px;
}

#Title {
    background-color: rgb(88, 88, 88);
    height: 5%;
    color: rgb(255, 255, 255);
    border-left-width: 3px;
    border-left-color: rgb(25, 25, 25);
    border-right-color: rgb(25, 25, 25);
    border-top-color: rgb(25, 25, 25);
    border-bottom-color: rgb(25, 25, 25);
    padding-left: 10px;
    flex-direction: row;
}

#About {
    width: 100%;
    height: 5%;
    background-color: rgb(34, 34, 32);
    border-top-color: rgb(29, 29, 29);
    border-bottom-color: rgb(29, 29, 29);
    border-top-width: 2px;
    border-bottom-width: 2px;
    padding-right: 5px;
    padding-left: 5px;
}

#About > * {
    padding-left: 1%;
    padding-right: 1%;
    -unity-text-align: middle-center;
}

#Items {
    background-color: rgb(34, 32, 24);
    border-right-width: 0;
    border-bottom-width: 0;
    border-left-color: rgb(17, 17, 17);
    border-right-color: rgb(17, 17, 17);
    border-top-color: rgb(17, 17, 17);
    border-bottom-color: rgb(17, 17, 17);
    border-top-width: 0;
    border-left-width: 0;
}

#PInventory {
    font-size: 25px;
    -unity-text-align: middle-left;
    flex-grow: 1;
    color: rgb(174, 174, 174);
    background-color: rgba(0, 0, 0, 0);
    text-shadow: 5px 0 0 rgb(0, 0, 0);
}

.font {
}

.QSlot {
    flex-grow: 1;
    max-height: 10%;
    border-bottom-width: 2px;
    border-top-width: 2px;
    border-left-color: rgb(0, 0, 0);
    border-right-color: rgb(0, 0, 0);
    border-top-color: rgb(44, 44, 44);
    border-bottom-color: rgb(26, 26, 26);
    padding-top: 1px;
    padding-bottom: 1px;
    flex-shrink: 1;
    flex-basis: 100px;
    background-size: 100% 100%;
    scale: 1 1;
    margin-bottom: 0;
    border-top-left-radius: 0;
    border-top-right-radius: 0;
    border-bottom-right-radius: 0;
    border-bottom-left-radius: 0;
    background-image: none;
    margin-top: 0;
    margin-right: 0;
    margin-left: 0;
    background-color: rgb(33, 33, 33);
}

#Weight {
    height: auto;
    width: 20%;
    bottom: auto;
    position: relative;
    flex-grow: 0;
    background-color: rgba(43, 43, 43, 0.29);
    -unity-text-align: middle-center;
}

#QSlots_Text {
    height: 5%;
    background-color: rgb(88, 88, 88);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    font-size: 8px;
    border-bottom-color: rgb(44, 44, 44);
    border-bottom-width: 2px;
    border-top-color: rgb(44, 44, 44);
    border-top-width: 2px;
    background-image: url("project://database/Assets/UI/IMG/ICONS/plecak_zamkniety_.png?fileID=2800000&guid=8f31986a6406307448899db41f894897&type=3#plecak_zamkniety_");
    -unity-background-scale-mode: scale-to-fit;
}

.QSlot Image {
    visibility: visible;
}

.item_ico {
    width: 10%;
    height: auto;
    margin-left: 0;
    padding-left: 0;
    padding-top: 0;
    padding-right: 0;
    padding-bottom: 0;
    margin-top: 0;
    margin-right: 0;
    margin-bottom: 0;
}

.item_name {
    width: 40%;
    margin-top: 0;
    margin-right: 0;
    margin-bottom: 0;
    margin-left: 0;
}

.item_type {
    width: 30%;
    margin-top: 0;
    margin-right: 0;
    margin-bottom: 0;
    margin-left: 0;
}

.item_quantity {
    width: 10%;
    margin-top: 0;
    margin-right: 0;
    margin-bottom: 0;
    margin-left: 0;
}

.item_weight {
    margin-top: 0;
    margin-right: 0;
    margin-bottom: 0;
    margin-left: 0;
    width: 10%;
}

.Item_Info {
    background-color: rgb(34, 34, 32);
    border-width: 2px;
    color: rgb(255, 255, 255);
    font-size: 20px;
    -unity-text-outline-width: 0;
    letter-spacing: 0;
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
}

.Item_Info:hover {
    color: rgb(255, 255, 255);
    background-color: rgb(34, 34, 32);
}

* {
    margin: 0;
    padding: 0;
}

.Item:hover {
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-top-left-radius: 2px;
    border-top-right-radius: 2px;
    border-bottom-right-radius: 2px;
    border-bottom-left-radius: 2px;
    background-color: rgb(34, 34, 32);
}

#Item_Icon {
    margin-top: 10px;
    margin-bottom: 0;
    margin-right: 0;
    margin-left: 0;
    display: flex;
    visibility: visible;
    overflow: visible;
}

.Item_QSlot {
    flex-direction: row-reverse;
    justify-content: center;
    align-content: center;
}

.Slot_Number {
    align-content: flex-start;
    align-self: center;
    font-size: 30px;
    -unity-text-align: upper-center;
    -unity-font-style: bold;
    padding-left: 3px;
}

.Slot_Info {
    -unity-text-align: upper-center;
    font-size: 20px;
    -unity-font-style: normal;
    padding-top: 1px;
    padding-right: 1px;
    padding-bottom: 1px;
    padding-left: 1px;
    text-overflow: ellipsis;
    color: rgb(192, 192, 192);
}

.Hand {
    width: 128px;
    height: 128px;
}

.Hand-Active {
    border-top-width: 5px;
    border-right-width: 5px;
    border-bottom-width: 5px;
    border-left-width: 5px;
    border-top-left-radius: 5px;
    border-top-right-radius: 5px;
    border-bottom-right-radius: 5px;
    border-bottom-left-radius: 5px;
    border-left-color: rgb(0, 0, 0);
    border-right-color: rgb(0, 0, 0);
    border-top-color: rgb(0, 0, 0);
    border-bottom-color: rgb(0, 0, 0);
}

#Crafting {
    left: 0;
    top: 0;
    bottom: 0;
    width: 45%;
    background-color: rgba(159, 159, 159, 0.82);
}

#CrafTitle {
    height: 5%;
    padding-top: 10px;
    padding-right: 10px;
    padding-bottom: 10px;
    padding-left: 10px;
    top: 0;
    background-color: rgb(88, 88, 88);
    border-right-width: 0;
    border-left-color: rgb(47, 47, 47);
    border-right-color: rgb(47, 47, 47);
    border-top-color: rgb(0, 0, 0);
    border-bottom-color: rgb(0, 0, 0);
    border-left-width: 0;
    flex-direction: row;
}

#CrafTitleText {
    font-size: 25px;
    flex-grow: 0;
    height: 100%;
    justify-content: flex-start;
    -unity-text-align: middle-left;
    white-space: normal;
    text-overflow: clip;
    -unity-font-style: bold;
    color: rgb(174, 174, 174);
    text-shadow: 5px 0 0 rgb(0, 0, 0);
}

#Actions {
    flex-direction: column;
    flex-wrap: nowrap;
    align-items: auto;
    width: 24%;
}

#CraftTable {
    flex-direction: row;
    width: 100%;
    height: 45%;
}

#Table {
    width: 74%;
    border-top-width: 4px;
    border-left-width: 4px;
    border-bottom-width: 4px;
    border-right-width: 4px;
    border-left-color: rgb(17, 17, 17);
    border-right-color: rgb(58, 58, 58);
    border-top-color: rgb(17, 17, 17);
    border-bottom-color: rgb(58, 58, 58);
    background-color: rgb(40, 40, 40);
    border-top-left-radius: 1px;
    border-top-right-radius: 1px;
    border-bottom-right-radius: 1px;
    border-bottom-left-radius: 1px;
}

#MakeButton {
    top: 0;
    height: 25%;
    width: 100%;
    background-color: rgb(38, 38, 38);
    justify-content: center;
    align-self: auto;
    align-content: auto;
    align-items: center;
    border-top-width: 3px;
    border-left-color: rgb(26, 26, 26);
    border-right-color: rgb(26, 26, 26);
    border-top-color: rgb(26, 26, 26);
    border-bottom-color: rgb(26, 26, 26);
}

#CraftingInfo {
    width: 100%;
    height: 70%;
    padding-top: 10px;
    padding-right: 10px;
    padding-bottom: 10px;
    padding-left: 10px;
    margin-top: 0;
    margin-right: 0;
    margin-bottom: 0;
    margin-left: 0;
    background-color: rgb(38, 38, 38);
    align-items: center;
    align-self: center;
}

#CraftAvalible {
    height: 50%;
    background-color: rgb(40, 38, 38);
    border-left-color: rgb(25, 25, 24);
    border-right-color: rgb(25, 25, 24);
    border-top-color: rgb(25, 25, 24);
    border-bottom-color: rgb(25, 25, 24);
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
    align-items: center;
    justify-content: center;
}

.CraftingSlot {
}

.CSlot {
    margin-right: 10px;
    margin-left: 10px;
    background-color: rgb(0, 0, 0);
}

#CraftingButton {
    flex-grow: 0;
    height: 50%;
    margin-top: 0;
    margin-right: 0;
    margin-bottom: 0;
    margin-left: 0;
    transition-duration: 0.1s;
    transition-timing-function: ease-in-out;
    scale: 1 1;
    width: 75%;
    flex-shrink: 1;
    background-color: rgb(63, 63, 63);
    border-left-color: rgb(84, 84, 84);
    border-right-color: rgb(26, 26, 26);
    border-top-color: rgb(84, 84, 84);
    border-bottom-color: rgb(26, 26, 26);
    border-top-width: 2px;
    border-right-width: 2px;
    border-bottom-width: 2px;
    border-left-width: 2px;
}

#CraftingButton:hover {
    margin-top: 5px;
    margin-right: 5px;
    margin-bottom: 5px;
    margin-left: 5px;
    scale: 1.1 1.1;
}

#TableAdditionaSlots {
    position: absolute;
    width: 100%;
    height: 100%;
    margin-top: 0;
    margin-right: 0;
    margin-bottom: 0;
    margin-left: 0;
}

.CSlotAdd {
    width: 20%;
    height: 20%;
    align-content: flex-start;
    align-self: center;
    justify-content: flex-start;
    align-items: auto;
}

#TableMultiSlot {
    width: 90%;
    height: 90%;
}

#CraftingInfoDiv {
    height: 80%;
    width: 80%;
    background-color: rgb(30, 30, 30);
    border-top-color: rgb(58, 58, 58);
    border-left-color: rgb(58, 58, 58);
    border-right-color: rgb(17, 17, 17);
    border-bottom-color: rgb(17, 17, 17);
    border-top-width: 4px;
    border-right-width: 4px;
    border-bottom-width: 4px;
    border-left-width: 4px;
}

.ItemsBG {
}

.row-even {
    background-color: rgb(35, 33, 30);
}

.row-odd {
    background-color: rgb(45, 43, 40);
}

#CraftingButton:active {
    translate: 0 3px;
    padding-top: 0;
    padding-right: 0;
    padding-bottom: 0;
    padding-left: 0;
}

#CraftList {
    width: 90%;
    height: 90%;
    border-top-width: 3px;
    border-right-width: 3px;
    border-bottom-width: 3px;
    border-left-width: 3px;
    border-top-color: rgb(58, 58, 58);
    border-left-color: rgb(58, 58, 58);
    border-right-color: rgb(17, 17, 17);
    border-bottom-color: rgb(17, 17, 17);
}

#TitleCraftable {
    height: 15%;
    flex-direction: row;
    background-color: rgb(43, 41, 41);
    color: rgb(228, 228, 228);
}

#CraftIcoTitle {
    width: 10%;
    background-image: none;
    -unity-background-scale-mode: scale-and-crop;
    background-position-y: center 0;
    background-position-x: center 0;
}

#CraftListTitle {
    -unity-text-align: middle-center;
    font-size: 32px;
    -unity-font-style: bold;
}

#WeightQslots {
    flex-grow: 1;
    align-items: center;
    background-color: rgb(33, 33, 33);
    color: rgb(255, 255, 255);
    -unity-text-align: middle-center;
    font-size: 8px;
    letter-spacing: 0;
    word-spacing: -10px;
    -unity-font-style: normal;
}

#OSTitle {
    height: 5%;
    background-color: rgb(88, 88, 88);
    padding-right: 10px;
    padding-left: 10px;
}

#OSAbout {
    width: 100%;
    height: 5%;
    background-color: rgb(34, 34, 32);
    border-top-color: rgb(29, 29, 29);
    border-bottom-color: rgb(29, 29, 29);
    border-top-width: 2px;
    border-bottom-width: 2px;
    padding-right: 5px;
    padding-left: 5px;
}

#OSAbout > * {
    padding-left: 1%;
    padding-right: 1%;
    -unity-text-align: middle-center;
}

#OSItems {
    background-color: rgb(34, 32, 24);
    border-right-width: 0;
    border-bottom-width: 0;
    border-left-color: rgb(17, 17, 17);
    border-right-color: rgb(17, 17, 17);
    border-top-color: rgb(17, 17, 17);
    border-bottom-color: rgb(17, 17, 17);
    border-top-width: 0;
    border-left-width: 0;
}

#OSInventory_text {
    font-size: 25px;
    -unity-text-align: middle-left;
    flex-grow: 1;
    color: rgb(174, 174, 174);
    background-color: rgba(0, 0, 0, 0);
    text-shadow: 5px 0 0 rgb(0, 0, 0);
}

Rondo {
    position: absolute;
    left: 50%;
    top: 50%;
    translate: 50% 50%;
    aspect-ratio: 1;
    width: 600px;
}
